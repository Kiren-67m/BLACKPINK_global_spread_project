# -----------------------------
# Global Plotly Theme: BLACKPINK (Light Background)
# -----------------------------
import plotly.io as pio

BLACKPINK_COLORWAY = [
    "#0B0B0B",  # black
    "#FF4FA3",  # BP pink
    "#B5179E",  # magenta-purple (small accent)
    "#7A7A7A",  # gray
]

pio.templates["blackpink_light"] = go.layout.Template(
    layout=go.Layout(
        paper_bgcolor="white",
        plot_bgcolor="white",
        font=dict(color="#0B0B0B"),
        title=dict(font=dict(color="#0B0B0B")),
        colorway=BLACKPINK_COLORWAY,
        xaxis=dict(
            showgrid=True,
            gridcolor="rgba(0,0,0,0.08)",
            zeroline=False,
            linecolor="rgba(0,0,0,0.20)",
            tickfont=dict(color="#0B0B0B"),
            titlefont=dict(color="#0B0B0B"),
        ),
        yaxis=dict(
            showgrid=True,
            gridcolor="rgba(0,0,0,0.08)",
            zeroline=False,
            linecolor="rgba(0,0,0,0.20)",
            tickfont=dict(color="#0B0B0B"),
            titlefont=dict(color="#0B0B0B"),
        ),
        legend=dict(
            bgcolor="rgba(255,255,255,0.6)",
            bordercolor="rgba(0,0,0,0.12)",
            borderwidth=1,
            font=dict(color="#0B0B0B"),
        ),
    )
)

pio.templates.default = "blackpink_light"import os
import pandas as pd
import numpy as np
import streamlit as st
import plotly.express as px
import plotly.graph_objects as go

# -----------------------
# Basic setup
# -----------------------
st.set_page_config(
    page_title="BLACKPINK Spotify Diffusion Dashboard",
    layout="wide"
)

st.title("BLACKPINK — Early Diffusion Dashboard (ERR-6 Baseline)")
st.caption("7-day window (Day0–Day6) • Core markets: Global / US / Indonesia • Metric: ERR-6 = Day6 / Peak within 7 days")

# -----------------------
# Data paths (works in Streamlit)
# -----------------------
DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")

FILES = {
    "metrics": os.path.join(DATA_DIR, "metrics_with_era.csv"),
    "era_summary": os.path.join(DATA_DIR, "era_market_anchor_summary.csv"),
    "gap": os.path.join(DATA_DIR, "main_vs_pre_gap.csv"),
}

missing = [k for k, p in FILES.items() if not os.path.exists(p)]
if missing:
    st.error(f"Missing files in dashboard/data: {missing}\n\nExpected:\n- metrics_with_era.csv\n- era_market_anchor_summary.csv\n- main_vs_pre_gap.csv")
    st.stop()

metrics = pd.read_csv(FILES["metrics"])
era_summary = pd.read_csv(FILES["era_summary"])
gap = pd.read_csv(FILES["gap"])

# Ensure numeric
for col in ["retention_day6_vs_peak", "peak_streams_calc", "day6_streams"]:
    if col in metrics.columns:
        metrics[col] = pd.to_numeric(metrics[col], errors="coerce")

# Standardize labels
# (Your markets are "Global","US","ID" already. If not, adjust here.)
MARKET_ORDER = ["Global", "US", "ID"]
ANCHOR_ORDER = ["Main", "Pre"]

# -----------------------
# Sidebar filters (PowerBI vibe)
# -----------------------
st.sidebar.header("Filters")

sel_markets = st.sidebar.multiselect(
    "Market",
    options=sorted(metrics["market"].dropna().unique().tolist(), key=lambda x: MARKET_ORDER.index(x) if x in MARKET_ORDER else 999),
    default=MARKET_ORDER
)

sel_anchor = st.sidebar.multiselect(
    "Anchor Type",
    options=[x for x in ANCHOR_ORDER if x in metrics["anchor_type"].unique().tolist()] + [x for x in metrics["anchor_type"].unique().tolist() if x not in ANCHOR_ORDER],
    default=[x for x in ANCHOR_ORDER if x in metrics["anchor_type"].unique().tolist()]
)

sel_era = st.sidebar.multiselect(
    "Era",
    options=metrics["era"].dropna().unique().tolist(),
    default=metrics["era"].dropna().unique().tolist()
)

show_table = st.sidebar.checkbox("Show data tables", value=False)

df = metrics[
    metrics["market"].isin(sel_markets) &
    metrics["anchor_type"].isin(sel_anchor) &
    metrics["era"].isin(sel_era)
].copy()

# -----------------------
# KPI cards (top row)
# -----------------------
def safe_mean(s):
    s = pd.to_numeric(s, errors="coerce").dropna()
    return float(s.mean()) if len(s) else np.nan

def safe_median(s):
    s = pd.to_numeric(s, errors="coerce").dropna()
    return float(s.median()) if len(s) else np.nan

def safe_max_row(dataframe, col):
    d = dataframe.dropna(subset=[col])
    if d.empty:
        return None
    idx = d[col].idxmax()
    return d.loc[idx]

kpi_cols = st.columns(5)

n_tracks = df["track_id"].nunique() if "track_id" in df.columns else df["track_name"].nunique()
avg_err6 = safe_mean(df["retention_day6_vs_peak"]) if "retention_day6_vs_peak" in df.columns else np.nan
med_err6 = safe_median(df["retention_day6_vs_peak"]) if "retention_day6_vs_peak" in df.columns else np.nan

best = safe_max_row(df, "retention_day6_vs_peak")
best_label = f"{best['track_name']} ({best['market']})" if best is not None else "—"
best_val = float(best["retention_day6_vs_peak"]) if best is not None else np.nan

jump_df = df[df["track_id"].astype(str).str.upper().eq("BP10") | df["track_name"].astype(str).str.upper().eq("JUMP")].copy()
jump_avg = safe_mean(jump_df["retention_day6_vs_peak"]) if not jump_df.empty else np.nan

kpi_cols[0].metric("Anchor Tracks (filtered)", f"{n_tracks}")
kpi_cols[1].metric("Avg ERR-6", f"{avg_err6:.3f}" if np.isfinite(avg_err6) else "—")
kpi_cols[2].metric("Median ERR-6", f"{med_err6:.3f}" if np.isfinite(med_err6) else "—")
kpi_cols[3].metric("Best ERR-6 (track)", f"{best_val:.3f}" if np.isfinite(best_val) else "—", help=best_label)
kpi_cols[4].metric("Jump (avg ERR-6)", f"{jump_avg:.3f}" if np.isfinite(jump_avg) else "—")

st.divider()

# -----------------------
# Grid charts (PowerBI layout)
# -----------------------
row1 = st.columns([2, 2, 2])
row2 = st.columns([2, 2, 2])
row3 = st.columns([3, 3])

# 1) Boxplot — ERR-6 by Market + Anchor Type
with row1[0]:
    st.subheader("ERR-6 Distribution by Market × Type")
    if df.empty:
        st.info("No data under current filters.")
    else:
        fig = px.box(
            df,
            x="market",
            y="retention_day6_vs_peak",
            color="anchor_type",
            category_orders={"market": MARKET_ORDER, "anchor_type": ANCHOR_ORDER},
            points="all",
        )
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
        fig.update_yaxes(range=[0, 1.05], title="ERR-6 (Day6 / Peak)")
        st.plotly_chart(fig, use_container_width=True)

# 2) Heatmap — avg ERR-6 (Era × Market)
with row1[1]:
    st.subheader("Avg ERR-6 Heatmap (Era × Market)")
    if df.empty:
        st.info("No data under current filters.")
    else:
        pivot = (
            df.groupby(["era", "market"], as_index=False)
              .agg(avg_err6=("retention_day6_vs_peak", "mean"))
        )
        heat = pivot.pivot(index="era", columns="market", values="avg_err6").reindex(columns=MARKET_ORDER)
        fig = px.imshow(
            heat,
            text_auto=".3f",
            aspect="auto"
        )
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
        st.plotly_chart(fig, use_container_width=True)

# 3) Bar — Main vs Pre gap (from exported gap table)
with row1[2]:
    st.subheader("Main − Pre Gap (avg ERR-6)")
    if gap.empty or "main_minus_pre" not in gap.columns:
        st.info("Gap table not available (main_vs_pre_gap.csv).")
    else:
        gap_f = gap.copy()
        if "era" in gap_f.columns and "market" in gap_f.columns:
            gap_f = gap_f[gap_f["market"].isin(sel_markets) & gap_f["era"].isin(sel_era)].copy()
        fig = px.bar(
            gap_f,
            x="era",
            y="main_minus_pre",
            color="market",
            barmode="group",
            category_orders={"market": MARKET_ORDER},
        )
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
        fig.update_yaxes(title="Main − Pre (avg ERR-6)")
        st.plotly_chart(fig, use_container_width=True)

# 4) Line — retention over time proxy (Era order) by Market
with row2[0]:
    st.subheader("Era Trend (Avg ERR-6)")
    if df.empty:
        st.info("No data under current filters.")
    else:
        trend = (
            df.groupby(["era", "market"], as_index=False)
              .agg(avg_err6=("retention_day6_vs_peak", "mean"), n=("track_id", "nunique"))
        )
        fig = px.line(
            trend,
            x="era",
            y="avg_err6",
            color="market",
            markers=True,
            category_orders={"market": MARKET_ORDER},
        )
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
        fig.update_yaxes(range=[0, 1.05], title="Avg ERR-6")
        st.plotly_chart(fig, use_container_width=True)

# 5) Scatter — Peak vs ERR-6 (size by day6 streams)
with row2[1]:
    st.subheader("Scale vs Stability (Peak vs ERR-6)")
    if df.empty or "peak_streams_calc" not in df.columns:
        st.info("Need peak_streams_calc in metrics_with_era.csv")
    else:
        plot_df = df.dropna(subset=["peak_streams_calc", "retention_day6_vs_peak"]).copy()
        fig = px.scatter(
            plot_df,
            x="peak_streams_calc",
            y="retention_day6_vs_peak",
            color="market",
            symbol="anchor_type",
            hover_data=["track_name", "era"],
            category_orders={"market": MARKET_ORDER, "anchor_type": ANCHOR_ORDER},
        )
        fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
        fig.update_yaxes(range=[0, 1.05], title="ERR-6")
        fig.update_xaxes(title="Peak Streams (within 7 days)")
        st.plotly_chart(fig, use_container_width=True)

# 6) “Jump vs History” — rank Jump inside Main releases by market
with row2[2]:
    st.subheader("Jump Positioning (within Main, by Market)")
    if df.empty:
        st.info("No data under current filters.")
    else:
        # Use full metrics (not filtered by anchor type), but keep market/era filters
        base = metrics[metrics["market"].isin(sel_markets) & metrics["era"].isin(sel_era)].copy()
        hist_main = base[(base["anchor_type"] == "Main") & (~base["track_name"].astype(str).str.upper().eq("JUMP"))].copy()
        jump = base[base["track_name"].astype(str).str.upper().eq("JUMP")].copy()

        rows = []
        for m in MARKET_ORDER:
            hv = hist_main.loc[hist_main["market"] == m, "retention_day6_vs_peak"].dropna()
            jv = jump.loc[jump["market"] == m, "retention_day6_vs_peak"].dropna()
            if len(hv) == 0 or len(jv) == 0:
                continue
            j = float(jv.iloc[0])
            pct = (hv < j).mean()  # percentile-ish
            rows.append({"market": m, "jump_err6": j, "percentile_vs_hist_main": pct})

        jstat = pd.DataFrame(rows)
        if jstat.empty:
            st.info("Jump not available under current filters.")
        else:
            fig = px.bar(
                jstat,
                x="market",
                y="percentile_vs_hist_main",
                text="jump_err6",
                category_orders={"market": MARKET_ORDER},
            )
            fig.update_layout(height=360, margin=dict(l=10, r=10, t=40, b=10))
            fig.update_yaxes(range=[0, 1], title="Percentile vs Historical Main (0–1)")
            fig.update_traces(texttemplate="ERR-6=%{text:.3f}", textposition="outside")
            st.plotly_chart(fig, use_container_width=True)

# Bottom row: tables / detail
with row3[0]:
    st.subheader("Track Detail (ERR-6)")
    view = df[["track_id","track_name","market","anchor_type","era","retention_day6_vs_peak","peak_streams_calc","day6_streams"]].copy()
    view = view.sort_values(["era","track_id","market"])
    st.dataframe(view, use_container_width=True, height=320)

with row3[1]:
    st.subheader("Era × Market × Type Summary (exported)")
    st.dataframe(era_summary, use_container_width=True, height=320)

if show_table:
    st.divider()
    st.subheader("Raw tables (debug)")
    st.write("metrics_with_era.csv")
    st.dataframe(metrics, use_container_width=True)
